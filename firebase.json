{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
            "predeploy": ["cd \"$RESOURCE_DIR\" && bun run build"]
        }
    ],
    "hosting": {
        "public": "dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "redirects": [
            {
                "source": "/regulamin",
                "destination": "https://docs.google.com/document/d/10V0JEs4Td39bX-TJb_HzQTnhXQX9kFeBqavDmYtkaKw/preview",
                "type": 303
            },
            {
                "source": "/info",
                "destination": "https://docs.google.com/document/d/10V0JEs4Td39bX-TJb_HzQTnhXQX9kFeBqavDmYtkaKw/preview",
                "type": 303
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "emulators": {
        "functions": {
            "port": 5001
        },
        "firestore": {
            "port": 8080
        },
        "hosting": {
            "port": 5000
        },
        "pubsub": {
            "port": 8085
        },
        "ui": {
            "enabled": true
        },
        "singleProjectMode": true
    }
}
